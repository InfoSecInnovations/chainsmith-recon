# Identity + I/O contract for the {name} check (Phase 56 §4).
# The loader reads this; `name` must match the folder name.

id: {uuid}
name: {name}
type: check
description: "{description}"
entry: check.py:{class_name}

suite: {suite}
depends_on:
  - output_name: services
    operator: truthy
produces: []

intrusive: false
service_types: [http, html, api]
parallel_safe: false

outputs:
  observations: [Observation]
side_effects: [network]
techniques: []
references: []
reason: ""

# Severity model (Phase 57 §7), required for built-in checks by verify-contracts.
# `fixed`: each discriminator's severity is known up front; list them under
# `observations:` as you add verdicts in grade(). `default` is the lowest
# severity this check emits, so a failed or deferred grade never over-escalates
# `on_critical`. Use `model: contextual` (with a `default`) when the grader
# decides severity from context.
severity:
  model: fixed
  default: info
